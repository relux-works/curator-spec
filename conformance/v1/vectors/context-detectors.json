  "pattern_classes": [
    {
      "group": 1,
      "pattern": "aws-access-key-id",
      "placeholder_prefix": "AKIA",
      "regexp": "(?:^|[^A-Z0-9])(AKIA[0-9A-Z]{16})(?:[^A-Z0-9]|$)"
    },
    {
      "group": 1,
      "pattern": "private-key-block",
      "placeholder_prefix": "",
      "regexp": "(-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP )?PRIVATE KEY(?: BLOCK)?-----)"
    },
    {
      "group": 1,
      "pattern": "bearer-token",
      "placeholder_prefix": "",
      "regexp": "(?:^|[^A-Za-z0-9])Bearer[ \\t]+([A-Za-z0-9._~+/-]{20,}=*)"
    }
  ],
  "placeholder_rule": "a match whose body, after the class's placeholder_prefix, is one repeated character or ends in EXAMPLE is a placeholder and is not reported",
  "protocol_version": "1.0.0-rc.9",
  "schema_version": 1,
  "scope": [
    "context/**",
    "agent-context.json",
    "agent-mcp.json",
    "CONTEXT.md"
  ],
  "span_rule": "byte offsets into the file, start inclusive and end exclusive, over the reported pattern group"
}
