  "surfacing_cases": [
    {
      "declarations": [
        {
          "args": [
            "-y",
            "figma-developer-mcp",
            "--stdio"
          ],
          "command": "npx",
          "env_names": [
            "FIGMA_API_KEY"
          ],
          "package": "figma-devmode",
          "transport": "stdio",
          "version": "1.2.0"
        }
      ],
      "expected_byte_length": 126,
      "expected_bytes": "mcp-declaration figma-devmode 1.2.0 stdio command=npx args=[\"-y\",\"figma-developer-mcp\",\"--stdio\"] env_names=[\"FIGMA_API_KEY\"]\n",
      "expected_sha256": "sha256:fec4f12e1b86882f745362bd7ed51b1999b392ffaf8e29fce0560f67c43d0bb0",
      "name": "single-stdio-declaration"
    },
    {
      "declarations": [
        {
          "command": "-",
          "env_names": [],
          "package": "zeta-http",
          "transport": "http",
          "version": "2.0.0"
        },
        {
          "args": [
            "tool@1.0",
            "serve"
          ],
          "command": "uvx",
          "env_names": [],
          "package": "alpha-stdio",
          "transport": "stdio",
          "version": "0.9.0"
        }
      ],
      "expected_byte_length": 159,
      "expected_bytes": "mcp-declaration alpha-stdio 0.9.0 stdio command=uvx args=[\"tool@1.0\",\"serve\"] env_names=[]\nmcp-declaration zeta-http 2.0.0 http command=- args=[] env_names=[]\n",
      "expected_sha256": "sha256:21779bc294c12f777054976e9d5595eac1b2e676046963490574a2216fe491af",
      "name": "stdio-and-http-ordering"
    },
    {
      "declarations": [
        {
          "args": [
            "-y",
            "figma-developer-mcp",
            "--stdio",
            "hello world"
          ],
          "command": "npx",
          "env_names": [
            "FIGMA_API_KEY"
          ],
          "package": "figma-devmode",
          "transport": "stdio",
          "version": "1.2.0"
        }
      ],
      "expected_byte_length": 140,
      "expected_bytes": "mcp-declaration figma-devmode 1.2.0 stdio command=npx args=[\"-y\",\"figma-developer-mcp\",\"--stdio\",\"hello world\"] env_names=[\"FIGMA_API_KEY\"]\n",
      "expected_sha256": "sha256:81889e773b59d5025e5c8f7bb088ddc01e6bdf73a0b37d9f140ccaac75f47bbd",
      "name": "args-with-space"
    },
    {
      "declarations": [
        {
          "args": [
            "say \"hi\"",
            "--stdio"
          ],
          "command": "npx",
          "env_names": [
            "FIGMA_API_KEY"
          ],
          "package": "figma-devmode",
          "transport": "stdio",
          "version": "1.2.0"
        }
      ],
      "expected_byte_length": 112,
      "expected_bytes": "mcp-declaration figma-devmode 1.2.0 stdio command=npx args=[\"say \\\"hi\\\"\",\"--stdio\"] env_names=[\"FIGMA_API_KEY\"]\n",
      "expected_sha256": "sha256:8416c615ff66dab69b27fba4ffe69406fd52e7e26ca69ee16002c0866cce9770",
      "name": "args-with-escaped-quote"
    },
