{
  "HOME": "/operator",
  "HOME_replaced": false,
  "env": {
    "XDG_CACHE_HOME": "/manager/environments/companyA/muse/cache",
    "XDG_CONFIG_HOME": "/manager/environments/companyA/muse/config",
    "XDG_DATA_HOME": "/manager/environments/companyA/muse/data",
    "XDG_STATE_HOME": "/manager/environments/companyA/muse/state"
  },
  "home": "/manager/environments/companyA/muse",
  "link_kind": "file-link",
  "managed_auth": "config/muse/auth.json",
  "native_auth": "/operator/config/muse/auth.json",
  "seeds": [
    "config/muse/settings.json",
    "config/muse/trust.json"
  ],
  "tool_directories": [
    "config/muse",
    "data/muse",
    "state",
    "cache"
  ]
}
