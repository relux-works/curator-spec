{
  "env": {
    "XDG_CACHE_HOME": "/manager/environments/companyA/muse/cache",
    "XDG_CONFIG_HOME": "/manager/environments/companyA/muse/config",
    "XDG_DATA_HOME": "/manager/environments/companyA/muse/data",
    "XDG_STATE_HOME": "/manager/environments/companyA/muse/state"
  },
  "environment": "muse",
  "fragment": "launch-env-fragment-v3",
  "permissions": {
    "locked": false,
    "mode": "native",
    "source": "profile"
  },
  "precedence": {
    "placement": "winner-last",
    "winner": "higher-weight"
  },
  "profile": {
    "lock_sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "name": "companyA"
  },
  "system_prompt": {
    "channels": [
      {
        "argument": "path",
        "flag": "--append-system-prompt-file",
        "kind": "flag",
        "semantics": "append"
      },
      {
        "argument": "path",
        "flag": "--system-prompt-file",
        "kind": "flag",
        "semantics": "replace"
      }
    ],
    "path": "/manager/environments/companyA/claude_code/.agent-context/system-prompt.md"
  }
}
