  "execution": {
    "operations": [
      "profile install (strict member audit)",
      "legacy global skill migration (strict member audit)"
    ],
    "input": "UTF-8 file contents and the skill manifest capability projection; absent manifest or network declaration means no covering declaration",
    "projection": "Compare every normalized undeclared network contact by host and file. Exempt hosts do not clear other findings. static_canary_blocks is independent of capability_check_passes; a true value always blocks the static canary gate.",
    "fixture_extraction_bound": "HTTP(S) URL hosts only; this corpus does not constrain other source-code detection syntax or claim a manager consumed the vectors."
  },
