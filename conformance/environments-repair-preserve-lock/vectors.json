  "execution_contract": {
    "current": "Provision a home matching the fixture lock, marker, generated surfaces, and configuration.",
    "forbidden_observations": "Each partial observation overrides the named case expected result and MUST be rejected as nonconforming.",
    "lock_replacement_before_repair_lock": "After the invocation reads its fixture lock and passes the read-only pre-check, another operation publishes the named replacement lock and its verified store snapshot before repair-lock acquisition. Observe only writes by the tested invocation. lock_bytes_unchanged means the tested invocation did not rewrite either lock; the before/after hashes include the concurrent publication. Both locks use framing version 2.",
    "repair_lock_acquired": "Observe acquisition attempts as well as successful acquisitions; false requires no attempt.",
    "stale": "Provision a matching home, then change a recorded managed surface without changing the fixture lock.",
    "status": "Register only the fixture profile and environment, with all other status rows current. Drive env status --check --json under a v2 writer; compare the selected home currency and command exit code. Do not repair or rewrite the v1 lock. No launch fragment is emitted by status.",
    "unprovisioned": "Leave the managed home absent; the fixture lock and verified store exist.",
    "usage": "The fixture exists but argv validation must fail before profile resolution.",
    "writes": "Observe every write including temporary staging, store publication, journals, locks, home surfaces, and markers. Successful repair writes list logical publication classes, not an exhaustive filesystem trace. Refusal and current-home empty lists require zero writes."
  },
