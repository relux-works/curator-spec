        "key": "model_instructions_file"
      }
    ]
  },
  "mcp": {
    "path": "home/curator-mcp.config.toml",
    "env_names": [],
    "channels": [
      {
        "kind": "flag",
        "flag": "-p",
        "argument": "name",
        "name": "curator-mcp"
      }
    ]
  }
}
