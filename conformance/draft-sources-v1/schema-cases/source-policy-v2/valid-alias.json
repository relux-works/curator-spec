{
  "schema_version": 2,
  "repositories": {
    "example.org/kit": {
      "endpoints": [
        {
          "url": "https://example.org/kit.git",
          "authentication": "team-https",
          "alias": "corp-mirror",
          "mirror_of": "example.org/kit"
        }
      ],
      "fallback": "none"
    }
  },
  "aliases": {
    "corp-mirror": {
      "host": "mirror.corp.example",
      "port": 8443,
      "authentication": "team-https"
    }
  }
}
