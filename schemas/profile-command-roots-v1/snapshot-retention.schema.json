{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/profile-command-roots-v1/snapshot-retention.schema.json",
  "type": "object",
  "properties": {
    "record": {
      "const": "profile-command-roots/1"
    },
    "descriptor_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "roots": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9_-])?$(?![\\s\\S])",
            "maxLength": 64
          },
          "binding": {
            "type": "object",
            "properties": {
              "lock_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              },
              "plan_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              },
              "generation": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              },
              "platform": {
                "enum": [
                  "darwin-arm64",
                  "darwin-amd64",
                  "linux-arm64",
                  "linux-amd64",
                  "windows-arm64",
                  "windows-amd64"
                ]
              },
              "receipt_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              },
              "marker_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              },
              "inventory_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              }
            },
            "required": [
              "lock_sha256",
              "plan_sha256",
              "generation",
              "platform",
              "receipt_sha256",
              "marker_sha256",
              "inventory_sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "profile",
          "binding"
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
      }
    }
  },
  "required": [
    "record",
    "descriptor_sha256",
    "roots",
    "references"
  ],
  "additionalProperties": false
}
