{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/profile-command-roots-v1/generation-marker.schema.json",
  "type": "object",
  "properties": {
    "record": {
      "const": "profile-command-generation/1"
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9_-])?$(?![\\s\\S])",
      "maxLength": 64
    },
    "binding": {
      "type": "object",
      "properties": {
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "platform": {
          "enum": [
            "darwin-arm64",
            "darwin-amd64",
            "linux-arm64",
            "linux-amd64",
            "windows-arm64",
            "windows-amd64"
          ]
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "lock_sha256",
        "plan_sha256",
        "generation",
        "platform",
        "inventory_sha256"
      ],
      "additionalProperties": false
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    }
  },
  "required": [
    "record",
    "profile",
    "binding",
    "receipt_sha256"
  ],
  "additionalProperties": false
}
