{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/profile-command-roots-v1/launcher-state.schema.json",
  "type": "object",
  "properties": {
    "record": {
      "const": "launcher-path-state/2"
    },
    "prior_state": {
      "$ref": "../profile-command-path-v1/launcher-state.schema.json"
    },
    "command_root": {
      "type": "object",
      "properties": {
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "generation": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "platform": {
          "enum": [
            "darwin-arm64",
            "darwin-amd64",
            "linux-arm64",
            "linux-amd64",
            "windows-arm64",
            "windows-amd64"
          ]
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "marker_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "required": [
        "lock_sha256",
        "plan_sha256",
        "generation",
        "platform",
        "receipt_sha256",
        "marker_sha256",
        "inventory_sha256"
      ],
      "additionalProperties": false
    },
    "lease_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "effective_path": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "path_value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    }
  },
  "required": [
    "record",
    "prior_state",
    "command_root",
    "lease_id",
    "effective_path",
    "path_value"
  ],
  "additionalProperties": false
}
