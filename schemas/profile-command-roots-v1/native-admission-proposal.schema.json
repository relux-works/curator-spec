{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/profile-command-roots-v1/native-admission-proposal.schema.json",
  "title": "Unaccepted native admission candidates; no wire allocation",
  "$comment": "Owner decisions remain CLOSED. This file is a review model, not production configuration.",
  "$defs": {
    "policy": {
      "type": "object",
      "properties": {
        "record": {
          "const": "candidate/profile-command-admission/1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "manager_home": {
          "type": "string",
          "pattern": "^/[^:;\\\\\\x00-\\x1f\\x7f]+$(?![\\s\\S])",
          "maxLength": 240
        },
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "entry_point": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^:;\\\\\\x00-\\x1f\\x7f]+$(?![\\s\\S])",
              "maxLength": 240
            },
            "legacy_excluded": {
              "const": true
            }
          },
          "required": [
            "path",
            "legacy_excluded"
          ],
          "additionalProperties": false
        },
        "writer_cohort": {
          "const": "operator-controlled"
        },
        "manager": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^:;\\\\\\x00-\\x1f\\x7f]+$(?![\\s\\S])",
              "maxLength": 240
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "distribution_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "capability": {
              "const": "native-command-roots-v1"
            }
          },
          "required": [
            "path",
            "sha256",
            "distribution_sha256",
            "capability"
          ],
          "additionalProperties": false
        },
        "launcher": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[^:;\\\\\\x00-\\x1f\\x7f]+$(?![\\s\\S])",
              "maxLength": 240
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "distribution_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "capability": {
              "const": "native-command-roots-v1"
            }
          },
          "required": [
            "path",
            "sha256",
            "distribution_sha256",
            "capability"
          ],
          "additionalProperties": false
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "profile": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])"
              },
              "lock_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
              },
              "required": {
                "const": true
              }
            },
            "required": [
              "profile",
              "lock_sha256",
              "required"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "record",
        "revision",
        "manager_home",
        "uid",
        "entry_point",
        "writer_cohort",
        "manager",
        "launcher",
        "profiles"
      ],
      "additionalProperties": false
    },
    "acquire": {
      "type": "object",
      "properties": {
        "record": {
          "const": "candidate/profile-command-acquire/1"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])"
        },
        "binding": {
          "type": "object",
          "properties": {
            "lock_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "generation": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "platform": {
              "enum": [
                "darwin-arm64",
                "darwin-amd64",
                "linux-arm64",
                "linux-amd64",
                "windows-arm64",
                "windows-amd64"
              ]
            },
            "receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "marker_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "inventory_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "lock_sha256",
            "plan_sha256",
            "generation",
            "platform",
            "receipt_sha256",
            "marker_sha256",
            "inventory_sha256"
          ],
          "additionalProperties": false
        },
        "supervisor_instance": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "process_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "process_started_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "if_revision": {
          "const": 0
        }
      },
      "required": [
        "record",
        "request_id",
        "profile",
        "binding",
        "supervisor_instance",
        "boot_id",
        "process_domain",
        "process_started_at",
        "if_revision"
      ],
      "additionalProperties": false
    },
    "session_key": {
      "type": "object",
      "properties": {
        "lease_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        },
        "if_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "lease_id",
        "request_id",
        "if_revision"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "record": {
          "const": "candidate/profile-command-generation-state/1"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])"
        },
        "binding": {
          "type": "object",
          "properties": {
            "lock_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "generation": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "platform": {
              "enum": [
                "darwin-arm64",
                "darwin-amd64",
                "linux-arm64",
                "linux-amd64",
                "windows-arm64",
                "windows-amd64"
              ]
            },
            "receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "marker_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "inventory_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "lock_sha256",
            "plan_sha256",
            "generation",
            "platform",
            "receipt_sha256",
            "marker_sha256",
            "inventory_sha256"
          ],
          "additionalProperties": false
        },
        "root": {
          "type": "string",
          "pattern": "^/[^:;\\\\\\x00-\\x1f\\x7f]+$(?![\\s\\S])",
          "maxLength": 240
        },
        "inventory": {
          "type": "string",
          "pattern": "^/[^:;\\\\\\x00-\\x1f\\x7f]+$(?![\\s\\S])",
          "maxLength": 240
        }
      },
      "required": [
        "record",
        "profile",
        "binding",
        "root",
        "inventory"
      ],
      "additionalProperties": false
    },
    "selected": {
      "type": "object",
      "properties": {
        "record": {
          "const": "candidate/profile-command-selection/1"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])"
        },
        "binding": {
          "type": "object",
          "properties": {
            "lock_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "generation": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "platform": {
              "enum": [
                "darwin-arm64",
                "darwin-amd64",
                "linux-arm64",
                "linux-amd64",
                "windows-arm64",
                "windows-amd64"
              ]
            },
            "receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "marker_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            },
            "inventory_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
            }
          },
          "required": [
            "lock_sha256",
            "plan_sha256",
            "generation",
            "platform",
            "receipt_sha256",
            "marker_sha256",
            "inventory_sha256"
          ],
          "additionalProperties": false
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "record",
        "profile",
        "binding",
        "revision"
      ],
      "additionalProperties": false
    },
    "replay": {
      "type": "object",
      "properties": {
        "record": {
          "const": "candidate/profile-command-replay/1"
        },
        "request": {
          "$ref": "#/$defs/acquire"
        },
        "pin": {
          "$ref": "https://relux-works.github.io/curator-spec/schemas/profile-command-roots-v1/session-pin.schema.json"
        }
      },
      "required": [
        "record",
        "request",
        "pin"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "acquire": {
      "$ref": "#/$defs/acquire"
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "selected": {
      "$ref": "#/$defs/selected"
    },
    "replay": {
      "$ref": "#/$defs/replay"
    }
  },
  "required": [
    "policy",
    "acquire",
    "generation",
    "selected",
    "replay"
  ],
  "additionalProperties": false
}
