{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/profile-command-roots-v1/native-admission-proposal.schema.json",
  "title": "Unaccepted native admission candidates; no wire allocation",
  "$comment": "Owner decisions remain CLOSED. This file is a review model, not production configuration.",
  "$defs": {
    "policy": {
      "type": "object",
      "properties": {
        "record": {
          "const": "candidate/native-root-policy/1"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "manager_home": {
          "$ref": "#/$defs/path"
        },
        "uid": {
          "type": "integer",
          "minimum": 1
        },
        "manager": {
          "$ref": "#/$defs/image"
        },
        "launcher": {
          "$ref": "#/$defs/image"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "profile": {
                "$ref": "#/$defs/profile"
              },
              "lock_sha256": {
                "$ref": "#/$defs/hex"
              }
            },
            "required": [
              "profile",
              "lock_sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "record",
        "revision",
        "manager_home",
        "uid",
        "manager",
        "launcher",
        "profiles"
      ],
      "additionalProperties": false
    },
    "acquire": {
      "type": "object",
      "properties": {
        "record": {
          "const": "candidate/profile-command-acquire/1"
        },
        "request_id": {
          "$ref": "#/$defs/hex"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "supervisor_instance": {
          "$ref": "#/$defs/hex"
        },
        "boot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "process_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "process_started_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "if_revision": {
          "const": 0
        }
      },
      "required": [
        "record",
        "request_id",
        "profile",
        "binding",
        "supervisor_instance",
        "boot_id",
        "process_domain",
        "process_started_at",
        "if_revision"
      ],
      "additionalProperties": false
    },
    "selected": {
      "type": "object",
      "properties": {
        "record": {
          "const": "candidate/profile-command-selection/1"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "record",
        "profile",
        "binding",
        "revision"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "string",
      "pattern": "^/[^:;\\\\\\x00-\\x1f\\x7f]+$(?![\\s\\S])",
      "maxLength": 240
    },
    "hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9_-])?$(?![\\s\\S])",
      "maxLength": 64
    },
    "binding": {
      "type": "object",
      "properties": {
        "lock_sha256": {
          "$ref": "#/$defs/hex"
        },
        "plan_sha256": {
          "$ref": "#/$defs/hex"
        },
        "generation": {
          "$ref": "#/$defs/hex"
        },
        "platform": {
          "enum": [
            "darwin-arm64",
            "darwin-amd64",
            "linux-arm64",
            "linux-amd64",
            "windows-arm64",
            "windows-amd64"
          ]
        },
        "receipt_sha256": {
          "$ref": "#/$defs/hex"
        },
        "marker_sha256": {
          "$ref": "#/$defs/hex"
        },
        "inventory_sha256": {
          "$ref": "#/$defs/hex"
        }
      },
      "required": [
        "lock_sha256",
        "plan_sha256",
        "generation",
        "platform",
        "receipt_sha256",
        "marker_sha256",
        "inventory_sha256"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "image": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/hex"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "record": {
          "const": "candidate/native-root-session/1"
        },
        "request": {
          "$ref": "#/$defs/acquire"
        },
        "pin": {
          "$ref": "https://relux-works.github.io/curator-spec/schemas/profile-command-roots-v1/session-pin.schema.json"
        }
      },
      "required": [
        "record",
        "request",
        "pin"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "selected": {
      "$ref": "#/$defs/selected"
    },
    "variant": {
      "enum": [
        "operator-prune",
        "pins"
      ]
    },
    "session": {
      "$ref": "#/$defs/session"
    }
  },
  "required": [
    "policy",
    "selected",
    "variant"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "variant": {
            "const": "pins"
          }
        }
      },
      "then": {
        "required": [
          "session"
        ]
      },
      "else": {
        "not": {
          "required": [
            "session"
          ]
        }
      }
    }
  ]
}
