{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/local-setup-token-v1/node-source-v1.schema.json",
  "title": "node-source-v1",
  "type": "object",
  "properties": {
    "mode": {
      "const": "node"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^local:[0-9a-f]{32}(?![\\s\\S])"
    },
    "harness_channel": {
      "const": "CLAUDE_CODE_OAUTH_TOKEN"
    }
  },
  "required": [
    "mode",
    "source_ref",
    "harness_channel"
  ],
  "additionalProperties": false
}
