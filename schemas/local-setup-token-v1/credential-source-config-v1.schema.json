{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/local-setup-token-v1/credential-source-config-v1.schema.json",
  "title": "credential-source-config-v1",
  "type": "object",
  "propertyNames": {
    "$ref": "../v1/common.schema.json#/$defs/identifier"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "claude_code": {
        "anyOf": [
          {
            "const": "per-home"
          },
          {
            "type": "string",
            "pattern": "^node:[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?![\\s\\S])",
            "maxLength": 133,
            "not": {
              "pattern": "^node:(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$)"
            }
          }
        ]
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
