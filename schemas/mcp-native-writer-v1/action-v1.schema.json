{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/mcp-native-writer-v1/action-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability",
    "scope",
    "profile_id",
    "environment",
    "path",
    "kind",
    "name",
    "server_sha256",
    "content_sha256",
    "operation",
    "approver",
    "policy_sha256",
    "state"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "capability": {
      "const": "profile-mcp-native-writer-v1"
    },
    "scope": {
      "const": "profile"
    },
    "profile_id": {
      "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
    },
    "environment": {
      "enum": [
        "claude_code",
        "codex_cli"
      ]
    },
    "path": {
      "enum": [
        ".agent-context/mcp/claude_code.json",
        "curator-mcp.config.toml"
      ]
    },
    "kind": {
      "const": "package-ownership-action"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "server_sha256": {
      "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/sha256"
    },
    "content_sha256": {
      "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/sha256"
    },
    "operation": {
      "enum": [
        "replace",
        "restore",
        "remove",
        "release"
      ]
    },
    "approver": {
      "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/nonEmptyString"
    },
    "policy_sha256": {
      "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/sha256"
    },
    "state": {
      "enum": [
        "active",
        "revoked"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "const": "claude_code"
          }
        }
      },
      "then": {
        "properties": {
          "path": {
            "const": ".agent-context/mcp/claude_code.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "environment": {
            "const": "codex_cli"
          }
        }
      },
      "then": {
        "properties": {
          "path": {
            "const": "curator-mcp.config.toml"
          }
        }
      }
    }
  ]
}
