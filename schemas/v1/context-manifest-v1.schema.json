{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/context-manifest-v1.schema.json",
  "title": "context.json schema 1",
  "type": "object",
  "required": ["version", "modules"],
  "properties": {
    "version": {"const": 1},
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"$ref": "common.schema.json#/$defs/portablePath"},
          "environments": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/identifier"}
          },
          "class": {"enum": ["root", "system"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
