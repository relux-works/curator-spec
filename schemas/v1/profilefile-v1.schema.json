{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/profilefile-v1.schema.json",
  "title": "Profilefile.json schema 1",
  "type": "object",
  "required": ["version", "profiles"],
  "properties": {
    "version": {"const": 1},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "common.schema.json#/$defs/identifier"},
      "additionalProperties": {"$ref": "common.schema.json#/$defs/portablePath"}
    }
  },
  "additionalProperties": false
}
