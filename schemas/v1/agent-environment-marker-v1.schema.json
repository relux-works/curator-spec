{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/agent-environment-marker-v1.schema.json",
  "title": ".agent-environment.json schema 1",
  "type": "object",
  "required": ["version", "profile", "mode", "surfaces"],
  "properties": {
    "version": {"const": 1},
    "profile": {
      "oneOf": [
        {
          "type": "object",
          "required": ["name", "source_kind", "source_identity", "ref", "commit"],
          "properties": {
            "name": {"$ref": "common.schema.json#/$defs/identifier"},
            "source_kind": {"const": "git"},
            "source_identity": {"$ref": "common.schema.json#/$defs/networkSourceIdentity"},
            "ref": {"$ref": "#/$defs/declaredRef"},
            "commit": {"$ref": "common.schema.json#/$defs/commit"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "source_kind", "state_sha256"],
          "properties": {
            "name": {"$ref": "common.schema.json#/$defs/identifier"},
            "source_kind": {"const": "local"},
            "state_sha256": {"$ref": "common.schema.json#/$defs/hex256"}
          },
          "additionalProperties": false
        }
      ]
    },
    "composition": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/compositionMember"}
    },
    "precedence": {"enum": ["later-overrides-earlier", "earlier-overrides-later"]},
    "mode": {"enum": ["managed-home", "linked", "copied"]},
    "surfaces": {
      "type": "object",
      "propertyNames": {"$ref": "common.schema.json#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/surfaceEntry"}
    },
    "seed_links": {"$ref": "common.schema.json#/$defs/pathSet"}
  },
  "dependentRequired": {
    "composition": ["precedence"],
    "precedence": ["composition"]
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "linked"}}, "required": ["mode"]},
      "then": {
        "properties": {
          "surfaces": {"additionalProperties": {"required": ["copy_fallback"]}}
        }
      },
      "else": {
        "properties": {
          "surfaces": {"additionalProperties": {"properties": {"copy_fallback": false}}}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "managed-home"}}, "required": ["mode"]},
      "then": true,
      "else": {"properties": {"seed_links": false}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "declaredRef": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["tag", "branch"]},
            "value": {"$ref": "common.schema.json#/$defs/gitRefName"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "revision"},
            "value": {"$ref": "common.schema.json#/$defs/commit"}
          },
          "additionalProperties": false
        }
      ]
    },
    "compositionMember": {
      "oneOf": [
        {
          "type": "object",
          "required": ["name", "commit"],
          "properties": {
            "name": {"$ref": "common.schema.json#/$defs/identifier"},
            "commit": {"$ref": "common.schema.json#/$defs/commit"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["name", "state_sha256"],
          "properties": {
            "name": {"$ref": "common.schema.json#/$defs/identifier"},
            "state_sha256": {"$ref": "common.schema.json#/$defs/hex256"}
          },
          "additionalProperties": false
        }
      ]
    },
    "surfaceEntry": {
      "type": "object",
      "required": ["paths", "content_sha256"],
      "properties": {
        "paths": {"$ref": "common.schema.json#/$defs/pathSet"},
        "form": {"enum": ["monolithic", "referenced"]},
        "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "copy_fallback": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
