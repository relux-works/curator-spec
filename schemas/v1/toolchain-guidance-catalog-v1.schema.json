{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/toolchain-guidance-catalog-v1.schema.json",
  "title": "Curator toolchain guidance catalog schema 1",
  "type": "object",
  "required": ["schema_version", "catalog_version", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"type": "integer", "minimum": 1, "maximum": 999999},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"oneOf": [{"$ref": "#/$defs/activeEntry"}, {"$ref": "#/$defs/retiredEntry"}]}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "activeEntry": {
      "type": "object",
      "required": [
        "guidance_id",
        "toolchain_id",
        "reason",
        "platform",
        "guidance_class",
        "primary_source",
        "summary",
        "active"
      ],
      "properties": {
        "guidance_id": {"$ref": "common.schema.json#/$defs/toolchainGuidanceIdV1"},
        "toolchain_id": {"$ref": "common.schema.json#/$defs/toolchainRegistryIdV1"},
        "reason": {"$ref": "common.schema.json#/$defs/toolchainDiagnosticReasonV1"},
        "platform": {"$ref": "common.schema.json#/$defs/toolchainGuidancePlatformV1"},
        "guidance_class": {"$ref": "common.schema.json#/$defs/toolchainGuidanceClassV1"},
        "primary_source": {"$ref": "#/$defs/primarySource"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
        "active": {"const": true}
      },
      "additionalProperties": false
    },
    "retiredEntry": {
      "type": "object",
      "required": [
        "guidance_id",
        "toolchain_id",
        "reason",
        "platform",
        "guidance_class",
        "primary_source",
        "summary",
        "active"
      ],
      "properties": {
        "guidance_id": {"$ref": "common.schema.json#/$defs/toolchainGuidanceIdV1"},
        "toolchain_id": {"$ref": "common.schema.json#/$defs/toolchainRegistryIdV1"},
        "reason": {"$ref": "common.schema.json#/$defs/toolchainDiagnosticReasonV1"},
        "platform": {"$ref": "common.schema.json#/$defs/toolchainGuidancePlatformV1"},
        "guidance_class": {"$ref": "common.schema.json#/$defs/toolchainGuidanceClassV1"},
        "primary_source": {"$ref": "#/$defs/primarySource"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
        "active": {"const": false},
        "superseded_by": {"$ref": "common.schema.json#/$defs/toolchainGuidanceIdV1"}
      },
      "additionalProperties": false
    },
    "primarySource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]{1,5})?/[^\\s]*$"
    }
  }
}
