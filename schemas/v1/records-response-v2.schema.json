{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/v1/records-response-v2.schema.json",
  "title": "Registry records response with page boundary",
  "type": "object",
  "required": ["records", "next_cursor", "boundary"],
  "properties": {
    "records": {"type": "array", "items": {"type": "object"}, "maxItems": 1000},
    "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
    "boundary": {"$ref": "registry-snapshot-v1.schema.json"}
  },
  "additionalProperties": false
}
