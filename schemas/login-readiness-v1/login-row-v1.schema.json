{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/login-readiness-v1/login-row-v1.schema.json",
  "title": "login-row-v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "$ref": "../v1/common.schema.json#/$defs/identifier"
    },
    "environment": {
      "enum": [
        "claude_code",
        "codex_cli",
        "muse",
        "pi",
        "opencode"
      ]
    },
    "current": {
      "type": "boolean"
    },
    "login": {
      "enum": [
        "present",
        "absent",
        "unknown"
      ]
    },
    "login_detail": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "per-home",
            "native",
            "environment",
            "node",
            "helper",
            "broker",
            "ambient"
          ]
        },
        "store": {
          "enum": [
            "native",
            "file",
            "keychain"
          ]
        },
        "backend": {
          "enum": [
            "file",
            "keychain",
            "environment",
            "external",
            "unknown"
          ]
        },
        "session": {
          "const": "caller"
        },
        "keychain_access": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ]
        },
        "reason": {
          "enum": [
            "candidate-present",
            "candidate-absent",
            "metadata-unavailable",
            "empty-file",
            "source-conflict",
            "untrusted-home",
            "unqualified-backend",
            "ambient"
          ]
        }
      },
      "required": [
        "source",
        "store",
        "backend",
        "session",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "profile",
    "environment",
    "current",
    "login",
    "login_detail"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "login": {
            "const": "present"
          }
        }
      },
      "then": {
        "properties": {
          "login_detail": {
            "properties": {
              "reason": {
                "const": "candidate-present"
              },
              "backend": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "login": {
            "const": "absent"
          }
        }
      },
      "then": {
        "properties": {
          "login_detail": {
            "properties": {
              "reason": {
                "const": "candidate-absent"
              },
              "backend": {
                "not": {
                  "const": "unknown"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "login": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "login_detail": {
            "properties": {
              "reason": {
                "not": {
                  "enum": [
                    "candidate-present",
                    "candidate-absent"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "environment": {
            "not": {
              "const": "claude_code"
            }
          }
        }
      },
      "then": {
        "properties": {
          "login_detail": {
            "not": {
              "required": [
                "keychain_access"
              ]
            }
          }
        }
      }
    }
  ]
}
