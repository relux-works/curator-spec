{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/profile-command-path-v1/root-receipt.schema.json",
  "type": "object",
  "required": [
    "receipt",
    "binding",
    "root",
    "commands"
  ],
  "additionalProperties": false,
  "properties": {
    "receipt": {
      "const": "profile-command-root/1"
    },
    "binding": {
      "type": "object",
      "required": [
        "profile",
        "lock_sha256",
        "plan_sha256",
        "generation"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "allOf": [
            {
              "allOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$",
                  "maxLength": 128
                },
                {
                  "not": {
                    "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$)"
                  }
                }
              ]
            },
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f]"
              }
            }
          ]
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        },
        "generation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "root": {
      "type": "object",
      "required": [
        "path",
        "metadata"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^(?:/[^:]*|[A-Za-z]:[\\\\/][^;]*)$(?![\\s\\S])"
            },
            {
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f]"
              }
            },
            {
              "not": {
                "pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)"
              }
            }
          ]
        },
        "metadata": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "platform",
                "owner",
                "filesystem_id",
                "object_id",
                "mode"
              ],
              "additionalProperties": false,
              "properties": {
                "platform": {
                  "const": "posix"
                },
                "owner": {
                  "type": "string",
                  "pattern": "^uid:(0|[1-9][0-9]*)$(?![\\s\\S])"
                },
                "filesystem_id": {
                  "type": "string",
                  "minLength": 1
                },
                "object_id": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4095
                }
              }
            },
            {
              "type": "object",
              "required": [
                "platform",
                "owner",
                "filesystem_id",
                "object_id",
                "security_descriptor_sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "platform": {
                  "const": "windows"
                },
                "owner": {
                  "type": "string",
                  "pattern": "^sid:S-[0-9]+(?:-[0-9]+)+$(?![\\s\\S])"
                },
                "filesystem_id": {
                  "type": "string",
                  "minLength": 1
                },
                "object_id": {
                  "type": "string",
                  "minLength": 1
                },
                "security_descriptor_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
                }
              }
            }
          ]
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "chain"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "allOf": [
              {
                "allOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$",
                    "maxLength": 128
                  },
                  {
                    "not": {
                      "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$)"
                    }
                  }
                ]
              },
              {
                "not": {
                  "pattern": "[\\x00-\\x1f\\x7f]"
                }
              }
            ]
          },
          "chain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "kind",
                "metadata",
                "sha256",
                "target"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "allOf": [
                    {
                      "pattern": "^(?:/[^:]*|[A-Za-z]:[\\\\/][^;]*)$(?![\\s\\S])"
                    },
                    {
                      "not": {
                        "pattern": "[\\x00-\\x1f\\x7f]"
                      }
                    },
                    {
                      "not": {
                        "pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)"
                      }
                    }
                  ]
                },
                "kind": {
                  "enum": [
                    "symlink",
                    "forwarder",
                    "executable"
                  ]
                },
                "metadata": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "platform",
                        "owner",
                        "filesystem_id",
                        "object_id",
                        "mode"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "platform": {
                          "const": "posix"
                        },
                        "owner": {
                          "type": "string",
                          "pattern": "^uid:(0|[1-9][0-9]*)$(?![\\s\\S])"
                        },
                        "filesystem_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "object_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "mode": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4095
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "platform",
                        "owner",
                        "filesystem_id",
                        "object_id",
                        "security_descriptor_sha256"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "platform": {
                          "const": "windows"
                        },
                        "owner": {
                          "type": "string",
                          "pattern": "^sid:S-[0-9]+(?:-[0-9]+)+$(?![\\s\\S])"
                        },
                        "filesystem_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "object_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "security_descriptor_sha256": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
                        }
                      }
                    }
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
                },
                "target": {
                  "oneOf": [
                    {
                      "type": "string",
                      "allOf": [
                        {
                          "pattern": "^(?:/[^:]*|[A-Za-z]:[\\\\/][^;]*)$(?![\\s\\S])"
                        },
                        {
                          "not": {
                            "pattern": "[\\x00-\\x1f\\x7f]"
                          }
                        },
                        {
                          "not": {
                            "pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)"
                          }
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
