{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/machine-claude-env-v1/claude-env.schema.json",
  "description": "Proposed claude_env member only; not a complete machine configuration carrier. Duplicate JSON members require decoder rejection.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "BASH_MAX_OUTPUT_LENGTH": {
      "type": "string",
      "pattern": "^(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-6])$",
      "minLength": 1,
      "maxLength": 5,
      "not": {
        "pattern": "[^0-9]"
      }
    }
  }
}
