{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/host-notification-v1/manager-config-v7.schema.json",
  "title": "Draft containing manager-config-v7 predecessor",
  "description": "Complete containing draft: schema-5 published members, schema-7 launcher selections and schema-8 notification; semantic predecessor constraints still apply.",
  "type": "object",
  "required": [
    "schema_version",
    "skills_root",
    "projects"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 7
    },
    "skills_root": {
      "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/skills_root"
    },
    "default_agents": {
      "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/default_agents"
    },
    "preferred_locale": {
      "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/preferred_locale"
    },
    "adapter_mode": {
      "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/adapter_mode"
    },
    "worktree_alias_pattern": {
      "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/worktree_alias_pattern"
    },
    "projects": {
      "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/projects"
    },
    "allowed_sources": {
      "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/allowed_sources"
    },
    "audit": {
      "anyOf": [
        {
          "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/audit"
        },
        {
          "type": "null"
        }
      ]
    },
    "audit_registries": {
      "anyOf": [
        {
          "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/audit_registries"
        },
        {
          "type": "null"
        }
      ]
    },
    "disable_builtin_registries": {
      "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/disable_builtin_registries"
    },
    "security_posture": {
      "$ref": "../rc7-carriers-v1/manager-config-v5.schema.json#/properties/security_posture"
    },
    "environments": {
      "type": "object",
      "properties": {
        "current_profile": {
          "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/profileNameOrNull",
          "default": null
        },
        "scoped_current": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "additionalProperties": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "default": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "overlays": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/overlay"
                }
              },
              "default": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "overlay_default_weight": {
          "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/nonNegativeSafeInteger",
          "default": 1000
        },
        "overlays_allowed": {
          "type": "boolean",
          "default": true
        },
        "precedence": {
          "anyOf": [
            {
              "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/precedence",
              "default": {
                "winner": "higher-weight",
                "placement": "winner-last"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "forms": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "additionalProperties": {
                "enum": [
                  "monolithic",
                  "referenced"
                ]
              },
              "default": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "system_prompt_files": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "additionalProperties": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/systemPromptFiles"
              },
              "default": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "targets": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "additionalProperties": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/target"
              },
              "default": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "isolation": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
                },
                "additionalProperties": {
                  "enum": [
                    "shared",
                    "isolated"
                  ]
                }
              },
              "default": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "permissions": {
          "type": "object",
          "propertyNames": {
            "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
          },
          "additionalProperties": {
            "enum": [
              "native",
              "yolo"
            ]
          },
          "default": {}
        },
        "xdg_seed_allowlist": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/xdgEntryName"
              },
              "uniqueItems": true,
              "default": [
                "git",
                "gh",
                "ssh"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "passable_env_names": {
          "oneOf": [
            {
              "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifierSet"
            },
            {
              "type": "null"
            }
          ],
          "default": []
        },
        "mcp_package_allowlist": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/nonEmptyString"
              },
              "uniqueItems": true,
              "default": []
            },
            {
              "type": "null"
            }
          ]
        },
        "shadow_acknowledged": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/shadowAcknowledgement"
              },
              "default": []
            },
            {
              "type": "null"
            }
          ]
        },
        "secret_material_waivers": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/secretMaterialWaiver"
              },
              "default": []
            },
            {
              "type": "null"
            }
          ]
        },
        "transitive_system_modules": {
          "enum": [
            "drop",
            "error"
          ],
          "default": "drop"
        },
        "system_module_waivers": {
          "type": "array",
          "items": {
            "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/systemModuleWaiver"
          },
          "default": []
        },
        "backup_retention": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 5
        },
        "require_current_profile": {
          "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/profileNameOrNull",
          "default": null
        },
        "in_place_mode": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/identifier"
              },
              "additionalProperties": {
                "enum": [
                  "linked",
                  "copied"
                ]
              },
              "default": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_directories": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "anyOf": [
                  {
                    "pattern": "^/"
                  },
                  {
                    "pattern": "^[A-Za-z]:[\\\\/]"
                  }
                ]
              },
              "uniqueItems": true,
              "default": []
            },
            {
              "type": "null"
            }
          ]
        },
        "source_signers": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "$ref": "https://relux-works.github.io/curator-spec/schemas/v1/common.schema.json#/$defs/nonEmptyString"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "https://relux-works.github.io/curator-spec/schemas/rc7-carriers-v1/manager-config-v5.schema.json#/$defs/sourceSigner"
                },
                "uniqueItems": true
              },
              "default": {}
            },
            {
              "type": "null"
            }
          ]
        },
        "require_source_signers": {
          "type": "boolean",
          "default": false
        },
        "credential_store": {
          "$ref": "https://relux-works.github.io/curator-spec/schemas/login-readiness-v1/credential-store-config-v1.schema.json"
        }
      },
      "additionalProperties": false
    },
    "build_ssh": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?:/[A-Za-z0-9._-]+)*$",
            "not": {
              "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
            },
            "$comment": "Host component is at most 253 bytes; semantic check required."
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agent": {
                "oneOf": [
                  {
                    "const": true
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "^(?:/|~/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
                    "not": {
                      "pattern": "[\\x00-\\x1f\\x7f]"
                    }
                  }
                ]
              },
              "identity": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?:/|~/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
                "not": {
                  "pattern": "[\\x00-\\x1f\\x7f]"
                }
              },
              "known_hosts": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?:/|~/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
                "not": {
                  "pattern": "[\\x00-\\x1f\\x7f]"
                }
              }
            },
            "anyOf": [
              {
                "required": [
                  "agent"
                ]
              },
              {
                "required": [
                  "identity"
                ]
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "build_https": {
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?:/[A-Za-z0-9._-]+)*$",
            "not": {
              "pattern": "(?:^|/)\\.{1,2}(?:/|$)"
            },
            "$comment": "Host component is at most 253 bytes; semantic check required."
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "token": {
                "enum": [
                  "git-credentials",
                  "keyring"
                ]
              },
              "token_env": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "username": {
                "type": "string",
                "maxLength": 4096,
                "minLength": 1
              }
            },
            "oneOf": [
              {
                "required": [
                  "token"
                ],
                "not": {
                  "required": [
                    "token_env"
                  ]
                }
              },
              {
                "required": [
                  "token_env"
                ],
                "not": {
                  "required": [
                    "token"
                  ]
                }
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "script_interpreters": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "node-v1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?:/|~/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
            },
            "python3-v1": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "^(?:/|~/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "script_diagnostics_dir": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:/|~/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "const": "portable"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "provider_id",
                "provider_version",
                "provider_binary_sha256",
                "provider_trust_evidence"
              ],
              "properties": {
                "mode": {
                  "const": "verified"
                },
                "provider_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
                },
                "provider_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$"
                },
                "provider_binary_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "minLength": 71,
                  "maxLength": 71
                },
                "provider_trust_evidence": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^\\S(?:[^\\x00-\\x1f\\x7f]*\\S)?$"
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "$ref": "extensions-v7.schema.json"
    }
  }
}
