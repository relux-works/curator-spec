{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/host-notification-v1/extensions.schema.json",
  "description": "Draft closed schema-8 machine launcher selections; no runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "claude_auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "store"
      ],
      "properties": {
        "type": {
          "const": "oauth"
        },
        "store": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "path"
              ],
              "properties": {
                "type": {
                  "const": "file"
                },
                "path": {
                  "$ref": "#/$defs/absolutePath"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "service",
                "account"
              ],
              "properties": {
                "type": {
                  "const": "keychain"
                },
                "service": {
                  "$ref": "#/$defs/reference"
                },
                "account": {
                  "$ref": "#/$defs/reference"
                }
              }
            }
          ]
        }
      }
    },
    "notification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend"
          ],
          "properties": {
            "backend": {
              "const": "off"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "contract",
            "workflow_reference",
            "workflow_sha256"
          ],
          "properties": {
            "backend": {
              "const": "host"
            },
            "contract": {
              "const": "curator-host-notification/1"
            },
            "workflow_reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:/@+\\-]+$",
              "not": {
                "pattern": "[^A-Za-z0-9._:/@+\\-]"
              }
            },
            "workflow_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "$comment": "UTF-8 byte bound, trim and Unicode control checks are semantic; see contract section 3."
    },
    "absolutePath": {
      "allOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "pattern": "^(?:/|[A-Za-z]:[\\\\/]|\\\\\\\\)"
        }
      ],
      "$comment": "Clean absolute path on the target platform; see contract section 3."
    }
  }
}
