{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/protected-command-inventory-v1/inventory.schema.json",
  "title": "Protected command inventory v1: inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_version",
    "normalization",
    "extractor_version",
    "extractor_sha256",
    "source_pins",
    "patterns",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "inventory_version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.[1-9][0-9]{0,8}$(?![\\s\\S])"
    },
    "normalization": {
      "const": "ascii-fold-wrapper-suffix-v1"
    },
    "extractor_version": {
      "const": "protected-command-inventory/1"
    },
    "extractor_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "source_pins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "source.schema.json"
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value",
          "class"
        ],
        "properties": {
          "kind": {
            "const": "prefix"
          },
          "value": {
            "const": "curator-"
          },
          "class": {
            "const": "manager"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "spellings",
          "provenance"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]+$(?![\\s\\S])"
          },
          "spellings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[!-~]+$(?![\\s\\S])"
            }
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "class"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])"
                },
                "class": {
                  "enum": [
                    "catalogue",
                    "system",
                    "shell",
                    "vcs",
                    "package-manager",
                    "platform",
                    "manager"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
