{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/protected-command-inventory-v1/artifact.schema.json",
  "title": "Protected command inventory v1: artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_inventory",
    "entry_count",
    "bytes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_inventory": {
      "$ref": "identity.schema.json"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    }
  }
}
