{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/protected-command-inventory-v1/sources.schema.json",
  "title": "Protected command inventory v1: sources",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_version",
    "normalization",
    "extractor_version",
    "extractor_sha256",
    "parsers",
    "source_pins",
    "coverage",
    "reference_content_pins"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "inventory_version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.[1-9][0-9]{0,8}$(?![\\s\\S])"
    },
    "normalization": {
      "const": "ascii-fold-wrapper-suffix-v1"
    },
    "extractor_version": {
      "const": "protected-command-inventory/1"
    },
    "extractor_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "parsers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yaml",
        "toml",
        "json"
      ],
      "properties": {
        "yaml": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
        },
        "toml": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
        },
        "json": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
        }
      }
    },
    "source_pins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "source.schema.json"
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "counts",
        "aqua_nodes",
        "required_names"
      ],
      "properties": {
        "counts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "aqua_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "required_names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!-~]+$(?![\\s\\S])"
          }
        }
      }
    },
    "reference_content_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idx/utilities.html",
        "utilities/V3_chap02.html",
        "utilities/V3_chap01.html"
      ],
      "properties": {
        "idx/utilities.html": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        },
        "utilities/V3_chap02.html": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        },
        "utilities/V3_chap01.html": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        }
      }
    }
  }
}
