{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/protected-command-inventory-v1/identity.schema.json",
  "title": "Protected command inventory v1: identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sha256",
    "normalization"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.[1-9][0-9]{0,8}$(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
    },
    "normalization": {
      "const": "ascii-fold-wrapper-suffix-v1"
    }
  }
}
