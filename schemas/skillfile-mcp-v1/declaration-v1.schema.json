{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/skillfile-mcp-v1/declaration-v1.schema.json",
  "oneOf": [
    {
      "type": "string",
      "minLength": 9,
      "maxLength": 4096
    },
    {
      "type": "object",
      "properties": {
        "server": {
          "allOf": [
            {
              "$ref": "../v1/agent-mcp-v1.schema.json#/properties/server"
            },
            {
              "properties": {
                "environments": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "claude_code",
                      "codex_cli",
                      "opencode",
                      "pi",
                      "muse"
                    ]
                  }
                }
              }
            }
          ]
        },
        "install": {
          "type": "object"
        }
      },
      "required": [
        "server"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "package": {
          "$ref": "../v1/agent-context-v1.schema.json#/$defs/mcpRequirement"
        },
        "install": {
          "type": "object"
        }
      },
      "required": [
        "package"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "server": {
      "allOf": [
        {
          "$ref": "../v1/agent-mcp-v1.schema.json#/properties/server"
        },
        {
          "properties": {
            "environments": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "claude_code",
                  "codex_cli",
                  "opencode",
                  "pi",
                  "muse"
                ]
              }
            }
          }
        }
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(?![\\s\\S])"
    },
    "environment": {
      "enum": [
        "claude_code",
        "codex_cli",
        "opencode",
        "pi",
        "muse"
      ]
    }
  },
  "$comment": "maxLength counts Unicode scalars for inline SERVER. Resolved packages additionally require legacy UTF-8 byte ceilings: URL 4096, command 255, each argument 8192; enforce semantically."
}
