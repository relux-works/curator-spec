{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relux-works.github.io/curator-spec/schemas/profile-codex-settings-v1/lock-members-v1.schema.json",
  "description": "Added top-level and per-context-member data, projected from a future versioned lock. Semantic rules bind origins to closure members and recompute effective settings.",
  "type": "object",
  "required": [
    "codex_settings",
    "codex_settings_contributions",
    "precedence"
  ],
  "properties": {
    "codex_settings": {
      "$ref": "codex-settings-v1.schema.json"
    },
    "codex_settings_contributions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "package",
          "settings"
        ],
        "properties": {
          "package": {
            "$ref": "../v1/common.schema.json#/$defs/identifier"
          },
          "settings": {
            "$ref": "codex-settings-v1.schema.json"
          }
        },
        "additionalProperties": false
      }
    },
    "precedence": {
      "$ref": "../v1/agent-environment-marker-v1.schema.json#/$defs/precedence"
    }
  },
  "additionalProperties": false
}
