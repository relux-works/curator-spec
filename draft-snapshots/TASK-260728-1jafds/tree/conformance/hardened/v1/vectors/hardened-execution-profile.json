  "capability_inventory": {
    "authority": "conformance/hardened/v1/vectors/hardened-execution-profile.json#capability_inventory",
    "availability_states": [
      "available",
      "unavailable",
      "unprobed"
    ],
    "classes": [
      {
        "name": "active-capability-probe",
        "optional": false,
        "requirement": "every class above is actively probed on this host in this operation before domain entry",
        "serves": [
          "fail-closed-capability-preflight"
        ]
      },
      {
        "name": "aggregate-resource-bounds",
        "optional": false,
        "requirement": "the host accounts for and enforces every bound of the resource guarantee over the domain in aggregate",
        "serves": [
          "hard-aggregate-descendant-resource-bounds"
        ]
      },
      {
        "name": "domain-atomic-termination",
        "optional": false,
        "requirement": "the whole domain is destroyed as one unit, with no survivor and no reparenting",
        "serves": [
          "hard-aggregate-descendant-resource-bounds"
        ]
      },
      {
        "name": "domain-membership-enforcement",
        "optional": false,
        "requirement": "every descendant of the domain-root worker is a domain member and cannot renounce membership",
        "serves": [
          "exact-executable-allowlisting",
          "hard-aggregate-descendant-resource-bounds",
          "private-build-root-only-writes",
          "total-network-denial"
        ]
      },
      {
        "name": "exec-path-allowlist",
        "optional": false,
        "requirement": "execution is denied for every path outside the exact fingerprinted allowlist",
        "serves": [
          "exact-executable-allowlisting"
        ]
      },
      {
        "name": "filesystem-view-restriction",
        "optional": false,
        "requirement": "paths outside the declared views are unreachable from inside the domain",
        "serves": [
          "private-build-root-only-writes",
          "read-only-source-and-toolchain"
        ]
      },
      {
        "name": "network-syscall-denial",
        "optional": false,
        "requirement": "the kernel denies every network operation on every address family for every domain member",
        "serves": [
          "total-network-denial"
        ]
      },
      {
        "name": "preexisting-endpoint-revocation",
        "optional": false,
        "requirement": "no inherited socket, handle, or connected endpoint is usable after domain entry",
        "serves": [
          "total-network-denial"
        ]
      },
      {
        "name": "read-only-source-view",
        "optional": false,
        "requirement": "the frozen source snapshot is presented through a kernel-enforced read-only view",
        "serves": [
          "read-only-source-and-toolchain"
        ]
      },
      {
        "name": "read-only-toolchain-view",
        "optional": false,
        "requirement": "the fingerprinted GOROOT is presented through a kernel-enforced read-only view",
        "serves": [
          "read-only-source-and-toolchain"
        ]
      },
      {
        "name": "write-path-confinement",
        "optional": false,
        "requirement": "every mutating filesystem operation outside the private build root is denied by the kernel",
        "serves": [
          "private-build-root-only-writes"
        ]
      }
    ],
    "exhaustive": true,
    "not_a_probe": [
      "a build-time constant",
      "a cached result from an earlier operation",
      "a configuration file",
      "a host label",
      "an operating-system version comparison alone"
    ],
    "probe_scope": "per-operation",
    "probe_timing": "pre-domain-entry",
    "status_states": [
      "applied",
      "not-applied"
    ],
    "version": "hardened-capability-inventory-v1"
  },
