  "ordering_invariants": [
    {
      "because": "a control cannot be applied before the host is known to provide it",
      "earlier": "capability-probe",
      "later": "domain-establishment",
      "name": "capability-probe-before-domain-establishment"
    },
    {
      "because": "the cache key carries the trusted-computing-base digest, so the trusted computing base must be verified first",
      "earlier": "tcb-identity-verification",
      "later": "build-input-and-cache-lookup",
      "name": "tcb-verification-before-cache-lookup"
    },
    {
      "because": "an exact verified hit compiles nothing, so it never creates a build domain",
      "earlier": "build-input-and-cache-lookup",
      "later": "domain-establishment",
      "name": "cache-lookup-before-domain-establishment"
    },
    {
      "because": "the domain-root worker is the first process inside the domain, so nothing can test from inside before it exists",
      "earlier": "domain-entry",
      "later": "in-domain-guarantee-self-test",
      "name": "domain-entry-before-in-domain-self-test"
    },
    {
      "because": "no package byte may reach a Go process until the kernel has been observed denying one representative operation per guarantee",
      "earlier": "in-domain-guarantee-self-test",
      "later": "go-list",
      "name": "self-test-before-package-exposure"
    },
    {
      "because": "the permit is issued only after the parent has rejected every forbidden dependency, directive, and native input",
      "earlier": "parent-graph-validation",
      "later": "build-permit",
      "name": "graph-validation-before-build-permit"
    },
    {
      "because": "the worker cannot proceed to a compiler on its own",
      "earlier": "build-permit",
      "later": "go-build",
      "name": "build-permit-before-go-build"
    },
    {
      "because": "the whole domain is destroyed and joined first, so re-verification observes trusted state no domain member can still change",
      "earlier": "domain-teardown",
      "later": "identity-reverification",
      "name": "teardown-before-identity-reverification"
    },
    {
      "because": "nothing is published under a trusted computing base that has not been proved byte-for-byte unchanged",
      "earlier": "identity-reverification",
      "later": "publication",
      "name": "identity-reverification-before-publication"
    },
    {
      "because": "nothing is published while a domain member is alive",
      "earlier": "domain-teardown",
      "later": "publication",
      "name": "teardown-before-publication"
    }
  ],
