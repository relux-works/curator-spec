  "architecture_v6_threat_matrix": [
    {
      "cases": [
        "sha1-tag-moved",
        "sha256-untagged"
      ],
      "threat": "mutable-or-symbolic-revision"
    },
    {
      "cases": [
        "local-substitution",
        "network-substitution-revision"
      ],
      "threat": "declared-effective-substitution-confusion"
    },
    {
      "cases": [
        "replace-ref",
        "graft"
      ],
      "threat": "replace-refs-or-grafts"
    },
    {
      "cases": [
        "promisor-pack",
        "partial-clone",
        "raw-object-reader-closed-shape"
      ],
      "threat": "partial-clone-or-lazy-fetch"
    },
    {
      "cases": [
        "alternate-object-store",
        "object-link"
      ],
      "threat": "alternates-or-object-store-escape"
    },
    {
      "cases": [
        "exact-fetch-closed-shape",
        "sha1-tag-missing",
        "untagged-object-missing"
      ],
      "threat": "fetch-default-or-tag-fallback"
    },
    {
      "cases": [
        "clean-git-session",
        "credential-helper-inert",
        "filter-config-inert"
      ],
      "threat": "ambient-config-url-proxy-helper"
    },
    {
      "cases": [
        "ssh-wrapper-closed-shape",
        "sha1-tag-match-ssh"
      ],
      "threat": "ssh-mitm-system-config-or-variant-argv"
    },
    {
      "cases": [
        "gitfile",
        "linked-worktree",
        "bare-repository",
        "reftable"
      ],
      "threat": "local-extension-ref-ambiguity"
    },
    {
      "cases": [
        "pack-v2-sha1",
        "pack-v3-sha1",
        "pack-v2-sha256",
        "pack-index-checksum-mismatch"
      ],
      "threat": "malicious-or-incomplete-pack-metadata"
    },
    {
      "cases": [
        "raw-object-reader-closed-shape",
        "raw-object-malformed"
      ],
      "threat": "object-reader-transformation-or-process-escape"
    },
    {
      "cases": [
        "raw-object-malformed",
        "sha1-tag-moved"
      ],
      "threat": "commit-tag-parser-disagreement"
    },
    {
      "cases": [
        "lfs-pointer",
        "submodule-gitlink",
        "filter-config-inert"
      ],
      "threat": "hook-filter-lfs-submodule-execution"
    },
    {
      "cases": [
        "path-collision",
        "package-argv-forbidden",
        "package-signing-request"
      ],
      "threat": "package-output-argv-or-signing-selection"
    },
    {
      "cases": [
        "audit-order-cache-hit",
        "protected-offline-reuse"
      ],
      "threat": "audit-bypass-on-cache-hit"
    },
    {
      "cases": [
        "cache-corrupt-receipt",
        "cache-corrupt-artifact"
      ],
      "threat": "forged-cache"
    },
    {
      "cases": [
        "shim-path-structural",
        "shim-collision-rollback"
      ],
      "threat": "shim-or-path-hijack"
    },
    {
      "cases": [
        "consumer-last-rollback",
        "shim-collision-rollback"
      ],
      "threat": "partial-or-cross-project-install"
    }
  ],
